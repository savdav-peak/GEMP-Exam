        score_pct = (correct / len(qs)) * 100
        st.metric(f"{sec} Score", f"{score_pct:.1f}%", f"{correct}/{len(qs)} Correct")
        
        with st.expander(f"Review {sec} Incorrect Answers"):
            for i, q in enumerate(qs):
